[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
CN = mia.localhost

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = mia.localhost
DNS.2 = warcraft3sounds.localhost
DNS.3 = stats.localhost
DNS.4 = localhost
IP.1 = 127.0.0.1
